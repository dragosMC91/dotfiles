# This is the configuration file for Ghostty.
#
# This template file has been automatically created at the following
# path since Ghostty couldn't find any existing config files on your system:
#
#   ~/Library/Application Support/com.mitchellh.ghostty/config
#

# Visual goodies
window-height = 39
window-width = 155

# Fonts
font-size = 19
font-family = "MesloLGS NF"

# Themes and color
theme = Dracula
foreground = #DEFFFF
#background-image = /Users/dragoscampean/Desktop/rain.jpg 
cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true
shell-integration-features = no-cursor
cursor-color = #50FA7B
adjust-cursor-thickness = 400%
adjust-cursor-height = 40%

middle-click-action = ignore

# Custom key binds
keybind = super+t=new_tab
keybind = super+alt+left=previous_tab
keybind = super+alt+right=next_tab
keybind = super+shift+r=reload_config

# Linux + Toshy: in terminals Toshy sends Cmd (physical Alt) as Ctrl and Opt (physical Win) as Alt,
# so the super+... binds above arrive as ctrl+...
keybind = ctrl+alt+arrow_left=previous_tab
keybind = ctrl+alt+arrow_right=next_tab
keybind = ctrl+shift+r=reload_config

auto-update = check
auto-update-channel = stable

